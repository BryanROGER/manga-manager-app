{
  "name": "Environnement Fullstack Manga",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/mysql:1": {
      "databaseName": "mangadb"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot-dashboard",
        "vscjava.vscode-spring-boot-extension-pack",
        "angular.ng-template"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "echo 'Environnement Java 21 et Node.js prêt !'"
}